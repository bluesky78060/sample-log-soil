{
  "name": "soil-sample-log",
  "productName": "토양 시료 접수 대장",
  "version": "1.14.19",
  "description": "My Electron application description",
  "main": "src/index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "vite src --port 3000",
    "dev:electron": "concurrently -k \"vite src --port 3000\" \"wait-on http://localhost:3000 && electron-forge start -- --dev\"",
    "dev:build": "vite build src",
    "preview": "vite preview src",
    "start": "electron-forge start",
    "start:dev": "DEV_MODE=1 electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "build": "npm run build:css && npm run sync-version && node scripts/extract-whatsnew.js && node scripts/embed-soil-template.js && npx vite build",
    "publish": "electron-forge publish",
    "lint": "eslint src --max-warnings 6",
    "test": "npx playwright test",
    "test:e2e": "npm run build && npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "sync-version": "node scripts/sync-version.js",
    "build:css": "tailwindcss -i src/styles/input.css -o src/shared/tailwind-output.css --minify",
    "watch:css": "tailwindcss -i src/styles/input.css -o src/shared/tailwind-output.css --watch",
    "sync": "npm run build",
    "capture:manual": "npx playwright test --config=playwright.manual.config.js"
  },
  "keywords": [],
  "author": "leechanhee",
  "license": "MIT",
  "dependencies": {
    "dexie": "^4.4.3",
    "dompurify": "^3.4.16",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "6.8.9",
    "firebase": "^12.7.0",
    "jszip": "^3.10.1",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/electron": "^1.4.38",
    "@types/node": "^25.0.2",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.4",
    "electron": "39.8.10",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "protobufjs": "^7.6.5",
    "js-yaml": "^4.3.2",
    "websocket-driver": "^0.7.5",
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  }
}
