# sample-log-soil 환경 변수 예시
# 이 파일을 복사하여 ".env"로 저장하고 실제 값을 채워 사용하세요.
# Electron main 프로세스 기동 시 자동 로드됩니다 (src/index.js).

# ==========================================
# JUSO(도로명주소) API
# ==========================================
# 발급: https://business.juso.go.kr/addrlink/openApi/apiReqstRgs.do
# 무료, 일 30만 호출 (개발), 심사 후 1,000만 호출 (운영)
JUSO_API_KEY=

# (선택) VWORLD API 키 - 지적 데이터/PNU 생성용
VWORLD_API_KEY=

# (선택) 카카오 REST API 키 - Local 주소 검색
KAKAO_API_KEY=
